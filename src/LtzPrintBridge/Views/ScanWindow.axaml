<Window RequestedThemeVariant="Dark" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LtzPrintBridge.Views.ScanWindow" Title="PrintBridge Scan" Width="300" Height="84"
        CanResize="False" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        FontFamily="Inter, Segoe UI, sans-serif" FontSize="12">
  <!-- A small dark strip: camera thumbnail, the last value, and two buttons. Drag anywhere to move it. -->
  <Border x:Name="Shell" Background="#16202A" CornerRadius="14" Padding="6" BorderBrush="#2B3A46" BorderThickness="1"
          PointerPressed="OnDrag">
    <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="10">
      <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True" Background="#0B1218" Width="96" Height="72">
        <Grid>
          <Image x:Name="Preview" Stretch="UniformToFill"/>
          <Grid Margin="16,14">
            <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="White" BorderThickness="2,2,0,0" CornerRadius="3,0,0,0"/>
            <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="White" BorderThickness="0,2,2,0" CornerRadius="0,3,0,0"/>
            <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="White" BorderThickness="2,0,0,2" CornerRadius="0,0,0,3"/>
            <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="White" BorderThickness="0,0,2,2" CornerRadius="0,0,3,0"/>
          </Grid>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="Status" Foreground="#93A4B1" FontSize="11" Text="Starting camera…" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Value" Foreground="White" FontFamily="Consolas, Menlo, monospace" FontSize="16" FontWeight="SemiBold"
                   Text="—" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Detail" Foreground="#93A4B1" FontSize="11" TextTrimming="CharacterEllipsis" IsVisible="False"/>
      </StackPanel>

      <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="2">
        <Button x:Name="CloseButton" Content="✕" Click="OnClose" ToolTip.Tip="Close" Width="26" Height="26" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" Foreground="#93A4B1" CornerRadius="13"/>
        <Button x:Name="MenuButton" Content="⋯" Click="OnMenu" ToolTip.Tip="Settings" Width="26" Height="26" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" Foreground="#93A4B1" CornerRadius="13"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
