<Window RequestedThemeVariant="Dark" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LtzPrintBridge.Views.ScanWindow" Title="PrintBridge Scan" Width="250" Height="46"
        CanResize="False" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        FontFamily="Inter, Segoe UI, sans-serif" FontSize="11">
  <!-- A thin dark strip: camera thumbnail, status line and last value. Drag to move, double-click to close,
       right-click for settings. -->
  <Border x:Name="Shell" Background="#16202A" CornerRadius="10" Padding="4" BorderBrush="#2B3A46" BorderThickness="1"
          PointerPressed="OnPointerPressed" ToolTip.Tip="Double-click to close · right-click for settings">
    <Grid ColumnDefinitions="50,*" ColumnSpacing="8">
      <Border Grid.Column="0" CornerRadius="7" ClipToBounds="True" Background="#0B1218" Width="50" Height="36">
        <Grid>
          <Image x:Name="Preview" Stretch="UniformToFill"/>
          <Grid Margin="8,6">
            <Border Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="White" BorderThickness="1.5,1.5,0,0"/>
            <Border Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="White" BorderThickness="0,1.5,1.5,0"/>
            <Border Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="White" BorderThickness="1.5,0,0,1.5"/>
            <Border Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="White" BorderThickness="0,0,1.5,1.5"/>
          </Grid>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock x:Name="Status" Foreground="#93A4B1" FontSize="10" Text="Starting camera…"/>
          <TextBlock x:Name="Detail" Foreground="#93A4B1" FontSize="10" TextTrimming="CharacterEllipsis" IsVisible="False"/>
        </StackPanel>
        <TextBlock x:Name="Value" Foreground="White" FontFamily="Consolas, Menlo, monospace" FontSize="14" FontWeight="SemiBold"
                   Text="—" TextTrimming="CharacterEllipsis"/>
      </StackPanel>

    </Grid>
  </Border>
</Window>
