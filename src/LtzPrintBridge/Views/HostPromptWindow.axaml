<Window RequestedThemeVariant="Light" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LtzPrintBridge.Views.HostPromptWindow" Title="PrintBridge" Width="460" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterScreen" Topmost="True" Background="White" FontFamily="Inter, Segoe UI, sans-serif">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="A website wants to use your printers" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
    <Border Background="#F4F7F7" BorderBrush="#D9E0E3" BorderThickness="1" CornerRadius="8" Padding="10,8"><TextBlock x:Name="HostText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap"/></Border>
    <TextBlock Text="If you allow it, this website can:" Foreground="#5D6C78"/>
    <TextBlock Text="•  See the names of your printers&#10;•  Send labels to them" Foreground="#5D6C78"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Block" Click="OnBlock" Foreground="#B42318" Background="White" BorderBrush="#D9E0E3" BorderThickness="1" Padding="14,8"/>
      <Button Content="Allow once" Click="OnOnce" Background="White" BorderBrush="#D9E0E3" BorderThickness="1" Padding="14,8"/>
      <Button Content="Always allow" Click="OnAlways" Background="#0B7A75" Foreground="White" Padding="14,8"/>
    </StackPanel>
  </StackPanel>
</Window>
